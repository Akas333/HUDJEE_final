# Copy this file to .env and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time, so they
# are readable by anyone with the APK. Only ever put the ANON key here, never
# the service_role key.
#
# After editing .env you must restart Metro with a cleared cache:
#   npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI adaptive engine (Railway). Optional until the engine is deployed.
EXPO_PUBLIC_API_URL=https://api.hudjee.com

# Google Sign-In. Create the OAuth clients in Google Cloud Console ->
# APIs & Services -> Credentials, then register the same IDs under
# Supabase -> Authentication -> Providers -> Google.
#
# The WEB client ID is required for the native flow on every platform: the ID
# token Google issues is always addressed to it, and Supabase validates that.
# Leave these unset to keep using the browser fallback (which is all Expo Go
# can do anyway).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
#
# iOS only. Also needs an Android client ID registered in Google Cloud with your
# package name + signing SHA-1 — that one is never referenced here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
